# Lumen Foundry Environment Configuration
# Copy to .env and fill in values

# Application
ENVIRONMENT=development
DEBUG=true
PORT=8000

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/lumen.db

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=lumen-foundry
KEYCLOAK_CLIENT_ID=lumen-frontend
KEYCLOAK_CLIENT_SECRET=
OIDC_DISCOVERY_URL=http://localhost:8080/realms/lumen-foundry/.well-known/openid-configuration

# LLM Configuration
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Inference defaults
MAX_MODEL_LEN=8192
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=512

# GPU monitoring
ENABLE_GPU_MONITORING=true

# Demo mode (local-only, refuses in production)
DEMO_MODE=true
